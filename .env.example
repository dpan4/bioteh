# ═══════════════════════════════════════════════════════════════════════════════
# AI-Native Gantt Chart — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Этот файл содержит все обязательные и опциональные переменные окружения
# для запуска бэкенда FastAPI.
#
# Инструкция:
# 1. Скопируйте этот файл в `.env` (в корне проекта или в `backend/`)
# 2. Заполните значения переменных (удалите комментарии, если нужно)
# 3. Перезапустите бэкенд: `uvicorn app.main:app --reload`
#
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# LLM Provider Configuration (обязательные параметры)
# ───────────────────────────────────────────────────────────────────────────────

# API-ключ для доступа к LLM-провайдеру (обязательный параметр)
# Получить ключ:
#   - OpenRouter: https://openrouter.ai/keys
#   - OpenAI: https://platform.openai.com/api-keys
#   - DeepSeek: https://platform.deepseek.com/api_keys
#   - Ollama: любое непустое значение (например, "ollama")
LLM_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Название модели LLM для чата и Tool Calling
# Примеры:
#   - OpenRouter: deepseek/deepseek-chat, anthropic/claude-3.5-sonnet, openai/gpt-4o-mini
#   - OpenAI: gpt-4o-mini, gpt-4-turbo
#   - DeepSeek: deepseek-chat
#   - Ollama: llama3.2, qwen2.5:7b, mistral
LLM_MODEL=deepseek/deepseek-chat

# Базовый URL для LLM API (опциональный, по умолчанию OpenRouter)
# Настройка провайдера:
#   - OpenRouter (по умолчанию): https://openrouter.ai/api/v1
#   - OpenAI: https://api.openai.com/v1
#   - DeepSeek: https://api.deepseek.com/v1
#   - Ollama (локально): http://localhost:11434/v1
#   - LM Studio (локально): http://localhost:1234/v1
#   - Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Максимальное количество токенов в ответе LLM (опциональный, по умолчанию 4096)
# Рекомендуется 4096-8192 для Tool Calling
LLM_MAX_TOKENS=4096

# ───────────────────────────────────────────────────────────────────────────────
# Backward Compatibility (устаревшие переменные, поддерживаются для совместимости)
# ───────────────────────────────────────────────────────────────────────────────

# Устаревшие имена переменных (если заполнены, переопределяют LLM_* выше)
# Рекомендуется использовать новые имена LLM_API_KEY, LLM_MODEL, LLM_BASE_URL
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ───────────────────────────────────────────────────────────────────────────────
# Backend Configuration (опциональные параметры)
# ───────────────────────────────────────────────────────────────────────────────

# Базовая дата старта проекта (опциональный, по умолчанию — сегодня)
# Формат: YYYY-MM-DD
# PROJECT_START_DATE=2026-08-01

# Порт бэкенда (опциональный, по умолчанию 8000)
# Используется в команде запуска: `uvicorn app.main:app --port PORT`
# PORT=8000

# ───────────────────────────────────────────────────────────────────────────────
# Development / Debug (опциональные параметры)
# ───────────────────────────────────────────────────────────────────────────────

# Режим отладки (опциональный, по умолчанию false)
# DEBUG=true

# Уровень логирования (опциональный, по умолчанию INFO)
# Варианты: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
